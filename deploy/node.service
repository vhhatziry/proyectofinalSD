# Tesoreria Distribuida - Equipo 18
# systemd service unit for a cluster node.
#
# Reads the TES_* environment from /etc/tesoreria/node.env (written by
# startup-script.sh) and launches the fat jar. The HTTP listen port is
# passed as the first program argument (Node.main args[0], default 8080).

[Unit]
Description=Tesoreria Distribuida node (Equipo 18)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tesoreria
Group=tesoreria

# Per-role TES_* variables (TES_DATASET, TES_JWT_SECRET, TES_LEADER_HOST, ...).
EnvironmentFile=/etc/tesoreria/node.env

WorkingDirectory=/opt/tesoreria

# HTTP listen port passed as args[0] to Node.main.
ExecStart=/usr/bin/java -jar /opt/tesoreria/tesoreria-distribuida.jar 8080

# Restart on crash so the node rejoins the cluster automatically.
Restart=on-failure
RestartSec=5

# Graceful stop must deliver SIGTERM so the JVM runs its shutdown hooks: on a
# replica the hook writes the exact checkpoint (the resume-from-exact-sequence
# guarantee rides on this), and on the leader it drains the durable journal
# queue. Allow time for the worst case (one GCS object, up to 3 retries x 15s)
# plus headroom, so systemd does not SIGKILL the process mid-upload.
KillSignal=SIGTERM
TimeoutStopSec=120

LimitNOFILE=65536

# Basic hardening.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
